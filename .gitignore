# MQTT broker credential file (issue #46): generated locally per README,
# mounted into the container at runtime — never committed.
mosquitto.passwd

# Local gitissue run state (issue analyses, run log)
.gitissue/

# Runtime run-state registry (issue #29): which simulations, data recorders
# and test campaigns are running is runtime data - written by the server,
# never committed. The .lock and .corrupt-* siblings belong to the same story.
src/server/data/runtime-state.json*

# Husky v9 internal helper (regenerated on `npm install` via the prepare script)
.husky/_/

# Built client bundle (regenerated by the Vite build in CI/Docker, see #42).
# Source lives in src/client/; the compiled output in src/public/ must not be
# tracked or it silently drifts from the source that produced it.
src/public/
