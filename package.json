{
  "name": "test_and_simulation",
  "version": "2.1.0",
  "description": "ENACT Test and Simulation Enabler",
  "scripts": {
    "start": "NODE_ENV=production node src/server/app.js",
    "server": "nodemon src/server/app.js",
    "test": "node --test-concurrency=1 --test \"test/**/*.test.js\"",
    "coverage": "node --test-concurrency=1 --experimental-test-coverage --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "spec": "node scripts/generate-openapi.js"
  },
  "nodemonConfig": {
    "verbose": true,
    "ignore": [
      "*.test.js",
      "Articles/*",
      "models/*",
      "node-red-flows/*",
      "src/client/*",
      "src/public/*",
      "src/server/data/*",
      "src/server/logs/*",
      "src/server/reports/*"
    ],
    "execMap": {
      "rb": "ruby",
      "pde": "processing --sketch={{pwd}} --run"
    }
  },
  "keywords": [
    "Test",
    "Simulation",
    "ENACT",
    "enabler"
  ],
  "author": "Montimage",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cookie-parser": "~1.4.3",
    "debug": "~2.6.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fstream": "^1.0.12",
    "geolib": "^3.2.1",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "lodash": "^4.17.20",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "mqtt": "^5.15.2",
    "mqtt-regex": "^1.0.5",
    "stompit": "^0.26.0",
    "winston": "^3.2.1"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-react": "^7.34.0",
    "file-loader": "^5.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.62.1",
    "prettier": "^2.8.8"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "qs": "^6.14.1"
  }
}
