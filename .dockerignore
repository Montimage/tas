# Broker credential (issue #46): supplied at runtime via a bind mount, never
# baked into the image.
mosquitto.passwd

# Client source is needed in the image so the dashboard is built at image
# build time (issue #42: stop committing the compiled bundle). It was
# previously excluded here, which forced the image to ship a stale committed
# build. Keep it in.
# src/client/

# Built client bundle — generated by the Dockerfile's client build step, never
# copied from a local checkout (which would be stale).
src/public/

# Composition artifacts (issue #45): the application image carries only the
# app and its own dependencies. The broker policy and the flow editor's
# assets ship to their own services through docker-compose.yml mounts.
docker-compose.yml
deploy/
node-red-flows/
mosquitto.conf
